'''
Given the following lines of code, work with your group members to place the lines in order to write and call a function that divides each value in an input list by 2.

a. result = []
b. for number in lst:
c. result.append(halved)
d. halved = number/2
e. halve_lst([2,4,6,8])
f. return result
g. def halve_lst(lst):


Example Output: [1,2,3,4]
'''

def halve_lst(lst):
    result = []
    for number in lst:
        halved = number//2 #divide by 2
        result.append(halved) #add to result
    return result

#Testing
print(halve_lst([2,4,6,8]))

